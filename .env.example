# Primary AI Provider: "openai" or "google".
AI_PROVIDER="openai"
OPENAI_MODEL="gpt-4o"
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Image Generation Provider Configuration
# Strictly choose provider: "openai" or "google". (No automatic fallback)
IMAGE_PROVIDER="openai"
OPENAI_IMAGE_MODEL="gpt-image-2.5-flare"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-lite-image"

# Text-to-Speech (TTS) Voice Narration Provider
# Strictly choose provider: "elevenlabs" or "google". (No automatic fallback)
# Voice casting is dynamically resolved via the Gemini Voice Casting Sub-Agent.
TTS_PROVIDER="elevenlabs"
ELEVENLABS_API_KEY=""

# BytePlus ModelArk / SeaDance Video Generation (console.byteplus.com)
# Register and grab API Key at https://console.byteplus.com (ModelArk)
BYTEPLUS_API_KEY=""
BYTEPLUS_BASE_URL="https://ark.ap-southeast.bytepluses.com/api/v3"
BYTEPLUS_VIDEO_MODEL="seedance-1-5-pro-251215"

# FFmpeg Video Assembly Render Server (M4 Apple Silicon Hardware Accelerated)
FFMPEG_SERVER_URL="https://syntax-observer-dust-maritime.trycloudflare.com"

